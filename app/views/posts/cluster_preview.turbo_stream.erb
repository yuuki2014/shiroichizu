<%= turbo_stream.update "bottom-sheet-container" do %>
  <div class="fixed inset-0 h-full pointer-events-none opacity-0 w-full z-40 flex flex-col justify-end transition-all duration-300"
        data-controller="bottom-sheet">

    <%# --- バックドロップ --- %>
    <div class="absolute inset-0 bg-black/50 z-0 pointer-events-auto"
          data-bottom-sheet-target="bottomSheetBackdrop"
          data-action="click->bottom-sheet#close"></div>

    <%# --- ボトムシート全体 --- %>
    <div data-bottom-sheet-target="bottomSheetBox"
          class="relative inset-x-0 bottom-0 z-10 flex flex-col w-full max-h-[75dvh] rounded-t-3xl bg-[#FFFBE6] pb-8 pt-8 shadow-[0_-5px_20px_rgba(0,0,0,0.1)] transition-transform translate-y-full duration-300 pointer-events-auto">

      <%# --- ドラッグハンドル --- %>
      <div class="absolute mx-auto mb-2 h-1.5 w-12 shrink-0 rounded-full bg-gray-400 top-3 left-1/2 -translate-x-1/2"></div>

      <%# --- ヘッダー --- %>
      <div class="modal-header shrink-0 z-20 w-full px-4">
        <div class="flex items-center justify-between border-b border-orange-200/60 pb-3 gap-2">
          <div class="flex flex-col min-w-0">
            <div class="font-bold text-gray-800 text-base">
              この周辺の投稿
            </div>
            <div class="text-sm text-gray-500 font-medium">
              <%= @posts.size %>件の投稿があります
            </div>
          </div>

          <button class="h-10 w-10 flex items-center justify-center bg-gray-500/50 hover:bg-gray-600/60 text-white rounded-full transition shrink-0"
                  data-action="click->bottom-sheet#close">
            <%= lucide_icon('x', class: "w-6 h-6") %>
          </button>
        </div>
      </div>

      <%# --- スクロールエリア --- %>
      <div class="flex-1 min-h-0 overflow-y-auto overscroll-contain px-4 pt-4 pb-4">
        <div class="w-full max-w-xl mx-auto flex flex-col gap-3">

          <% @posts.each do |post| %>
            <div class="relative w-full rounded-2xl bg-white/80 border border-orange-100 shadow-sm overflow-hidden active:scale-[0.99] transition">

              <% if post.user_id == current_user.id %>
                <div class="absolute top-3 right-3 z-30"
                    data-controller="dropdown"
                    data-dropdown-post-url-value="<%= confirm_destroy_post_path(post) %>">
                  <button type="button"
                          class="h-10 w-10 flex items-center justify-center bg-gray-500/50 hover:bg-gray-600/60 text-white rounded-full transition"
                          data-action="click->dropdown#toggle">
                    <%= lucide_icon('ellipsis-vertical', class: "w-6 h-6") %>
                  </button>
                </div>
              <% end %>

              <%= link_to post_path(post),
                class: "block w-full text-left",
                data: { turbo_stream: true } do %>

                <%# --- 投稿ヘッダー --- %>
                <div class="flex items-center gap-3 px-3 pt-3 pb-2">
                  <div class="shrink-0">
                    <% if post.user.avatar.attached? %>
                      <%= image_tag avatar_url(post.user),
                                    class: "w-10 h-10 object-cover rounded-full shadow-sm" %>
                    <% else %>
                      <div class="w-10 h-10 bg-orange-400 rounded-full flex items-center justify-center shadow-sm">
                        <%= lucide_icon('user-round', class: "w-6 h-6 text-white") %>
                      </div>
                    <% end %>
                  </div>

                  <div class="flex flex-col justify-center gap-1 flex-1 min-w-0">
                    <div class="font-bold text-gray-800 text-sm truncate">
                      <%= post.user.nickname %>
                    </div>
                    <div class="text-xs text-gray-500 font-medium truncate">
                      <%= post.visited_at&.strftime("%Y/%m/%d %H:%M") %>
                    </div>
                  </div>

                </div>

                <%# 本文 %>
                <% if post.body.present? %>
                  <% text_classes = post.images.attached? ? "line-clamp-3 shrink-0" : "" %>

                  <div class="px-3 pb-3 text-gray-700 text-sm whitespace-pre-wrap leading-snug font-medium <%= text_classes %>"><%= post.body %></div>
                <% end %>

                <%# --- 画像エリア --- %>
                <% if post.images.attached? %>
                  <% image_count = post.images.size %>

                  <% if image_count == 1 %>
                    <div class="px-3 pb-3">
                      <div class="relative w-full aspect-[16/9] overflow-hidden rounded-xl bg-orange-50"
                            data-controller="image-loader">
                        <div class="absolute inset-0 flex items-center justify-center transition-opacity"
                              data-image-loader-target="placeholder">
                          <div class="w-8 h-8 border-2 border-gray-200 border-t-gray-500 rounded-full animate-spin"></div>
                        </div>

                        <%= image_tag media_image_url(post.images.first.variant(:thumb).key),
                                      loading: "lazy",
                                      class: "absolute inset-0 w-full h-full object-cover rounded-xl shadow-sm opacity-0 transition-opacity duration-300",
                                      data: {
                                        image_loader_target: "image",
                                        action: "load->image-loader#loaded error->image-loader#error"
                                      } %>
                      </div>
                    </div>

                  <% else %>
                    <div class="px-3 pb-3">
                      <div class="grid grid-cols-2 gap-1 w-full rounded-xl overflow-hidden bg-orange-50">
                        <% post.images.first(4).each_with_index do |image, index| %>
                          <div class="relative w-full aspect-[4/3]"
                                data-controller="image-loader"
                                style="container-type: inline-size;">
                            <div class="absolute inset-0 flex items-center justify-center transition-opacity"
                                  data-image-loader-target="placeholder">
                              <div class="w-8 h-8 border-2 border-gray-200 border-t-gray-500 rounded-full animate-spin"></div>
                            </div>

                            <%= image_tag media_image_url(image.variant(:thumb).key),
                                          loading: "lazy",
                                          class: "absolute inset-0 w-full h-full object-cover shadow-sm opacity-0 transition-opacity duration-300",
                                          data: {
                                            image_loader_target: "image",
                                            action: "load->image-loader#loaded error->image-loader#error"
                                          } %>

                            <% if index == 3 && image_count > 4 %>
                              <div class="absolute inset-0 bg-black/60 flex items-center justify-center">
                                <span class="text-white font-bold tracking-wider text-center"
                                      style="font-size: 22cqw;">
                                  + <%= image_count - 4 %>
                                </span>
                              </div>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                <% end %>

              <% end %>

            </div>
          <% end %>

        </div>
      </div>
    </div>
  </div>
<% end %>
